@HaveStyle = LabelStyle(FontSize: 16, TextColor: #6dca9b, VerticalAlignment: Center);
@NeedStyle = LabelStyle(FontSize: 16, TextColor: #de7979, VerticalAlignment: Center);
Group {
 Anchor: (Height: 64, Bottom: 4); LayoutMode: Left;
 Group { Anchor: (Width: 58, Height: 58, Right: 8); Background: "../../Common/IngredientSlot.png";
  ItemIcon #Icon { Anchor: (Full: 4); ShowItemTooltip: true; }
 }
 Group { FlexWeight: 1; LayoutMode: Top;
  Label #Name { Anchor: (Height: 30); Style: (FontSize: 15, TextColor: #b4c8c9, Wrap: true, VerticalAlignment: Center); }
  Label #Quantity { Anchor: (Height: 24); Style: (FontSize: 16, TextColor: #b4c8c9, VerticalAlignment: Center); }
 }
}
