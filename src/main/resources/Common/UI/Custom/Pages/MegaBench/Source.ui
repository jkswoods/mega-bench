Button {
 Anchor: (Height: 66, Bottom: 4);
 Style: (Default: (Background: #172433), Hovered: (Background: #263950), Pressed: (Background: #304963));
 Group #Selected { Anchor: (Left: 0, Width: 3, Top: 0, Bottom: 0); Background: #e8cc81; Visible: false; }
 Group { Anchor: (Full: 5); LayoutMode: Left;
  ItemIcon #Icon { Anchor: (Width: 54, Height: 54, Right: 8); HitTestVisible: false; }
  Group { FlexWeight: 1; LayoutMode: Top;
   Label #Name { Anchor: (Height: 34); Style: (FontSize: 17, TextColor: #d3d6db, RenderBold: true, VerticalAlignment: Center, Wrap: true); }
   Label #State { Anchor: (Height: 20); Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); }
  }
 }
}
